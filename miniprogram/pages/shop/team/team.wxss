.team-hero {
  padding: 32rpx 28rpx 28rpx;
}

.team-title {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 900;
}

.team-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  padding-right: 22rpx;
}

.hero-copy,
.hero-refresh {
  position: relative;
  z-index: 1;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-copy {
  padding: 12rpx 20rpx;
}

.invite-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.12);
}

.invite-code {
  color: #ffffff;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.hero-refresh {
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}

.role-panel {
  margin-top: 14rpx;
}

.team-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.team-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.team-row:first-child {
  padding-top: 0;
}

.staff-name {
  font-size: 30rpx;
  font-weight: 900;
}

.staff-meta {
  justify-content: flex-start;
  margin-top: 8rpx;
}

.chip-remove {
  color: var(--color-danger);
  border-color: var(--color-danger);
}

.role-help {
  background: #ffffff;
}

.role-help-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.role-manager {
  color: var(--color-success);
  font-weight: 800;
}

.role-staff {
  color: var(--color-text-secondary);
  font-weight: 800;
}

.role-help-line {
  margin-top: 6rpx;
}

.role-help-muted {
  margin-top: 10rpx;
  color: var(--color-text-muted);
}

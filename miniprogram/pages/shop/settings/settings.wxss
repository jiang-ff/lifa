.settings-head {
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(37, 99, 235, 0.06));
}

.env-card,
.monitor-card {
  margin-bottom: 20rpx;
}

.env-meta {
  margin: 20rpx 0 16rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.env-meta-item {
  padding: 18rpx 20rpx;
  background: rgba(248, 250, 252, 0.95);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.env-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.env-id {
  font-size: 24rpx;
  word-break: break-all;
}

.env-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.env-btn,
.env-btn-active,
.env-reset,
.monitor-refresh {
  min-height: 80rpx;
  font-size: 24rpx;
}

.env-reset {
  width: 100%;
  margin-top: 12rpx;
}

.settings-tip {
  line-height: 1.6;
  margin-top: 16rpx;
}

.monitor-section {
  margin-top: 20rpx;
}

.log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.log-item:last-child {
  border-bottom: 0;
}

.log-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.log-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.log-detail {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  word-break: break-all;
}

.monitor-empty {
  padding: 18rpx 0 8rpx;
}

.hero {
  background: linear-gradient(
    135deg,
    rgba(79, 70, 229, 0.06),
    rgba(99, 102, 241, 0.03)
  );
  border: 1rpx solid rgba(79, 70, 229, 0.08);
}

.tx {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.tx:first-child {
  border-top: 0;
  padding-top: 0;
}

.tx:last-child {
  padding-bottom: 0;
}

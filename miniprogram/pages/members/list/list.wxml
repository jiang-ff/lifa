<view class="container safe-bottom">
  <view class="card">
    <view class="row">
      <view>
        <view class="title">会员</view>
        <view class="subtitle">共 {{membersTotal}} 位，今天也要把“本子”卷成“系统”</view>
      </view>
      <button class="btn-secondary" size="mini" bindtap="goAdd">新增</button>
    </view>

    <view style="height: 16rpx;"></view>

    <view class="row gap-12">
      <input
        class="input"
        value="{{keyword}}"
        placeholder="搜姓名/手机号"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        style="flex: 1;"
      />
      <button class="btn" size="mini" bindtap="onSearch">搜索</button>
    </view>

    <view style="height: 14rpx;"></view>

    <view class="row gap-12">
      <view class="seg" style="flex: 1;">
        <view class="seg-item {{sortKey === 'updatedAt' ? 'seg-item-active' : ''}}" bindtap="setSort" data-key="updatedAt">最近</view>
        <view class="seg-item {{sortKey === 'balance' ? 'seg-item-active' : ''}}" bindtap="setSort" data-key="balance">余额</view>
        <view class="seg-item {{sortKey === 'name' ? 'seg-item-active' : ''}}" bindtap="setSort" data-key="name">姓名</view>
      </view>
      <view class="chip chip-outline" bindtap="toggleHasBalance">{{hasBalanceOnly ? '仅有余额' : '全部'}}</view>
    </view>
  </view>

  <view style="height: 16rpx;"></view>

  <block wx:if="{{loading}}">
    <view class="muted" style="text-align: center; padding: 40rpx 0;">加载中…</view>
  </block>

  <block wx:elif="{{members.length === 0}}">
    <view class="card" style="text-align: center;">
      <view style="font-size: 32rpx; font-weight: 800;">还没有会员</view>
      <view class="muted" style="margin-top: 10rpx;">先来一位“Tony 老师指定客户”，让系统见识下什么叫复购。</view>
      <view style="height: 18rpx;"></view>
      <button class="btn-secondary" bindtap="goAdd">新增会员</button>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{members}}" wx:key="_id" class="card member-card">
      <view class="row" bindtap="goDetail" data-id="{{item._id}}">
        <view class="row" style="justify-content: flex-start;">
          <view class="avatar">{{item.avatarText}}</view>
          <view style="margin-left: 16rpx;">
            <view style="font-size: 34rpx; font-weight: 800;">{{item.name || "未命名"}}</view>
            <view class="muted" style="margin-top: 6rpx;">{{item.phone || "-"}} · {{item.updatedText}}</view>
          </view>
        </view>

        <view style="text-align: right;">
          <view class="chip {{item.balance > 0 ? 'chip-green' : 'chip-gray'}}">¥ {{item.balance}}</view>
          <view class="muted" style="margin-top: 10rpx; font-size: 24rpx;">点击查看</view>
        </view>
      </view>

      <view style="height: 16rpx;"></view>
      <view class="row gap-12">
        <view class="chip chip-outline" bindtap="quickRecharge" data-id="{{item._id}}">充值</view>
        <view class="chip chip-outline" bindtap="quickConsume" data-id="{{item._id}}">消费</view>
        <view class="chip chip-outline" bindtap="goEdit" data-id="{{item._id}}">编辑</view>
        <view class="chip chip-outline" bindtap="callPhone" data-phone="{{item.phone}}">拨打</view>
      </view>
    </view>
  </block>
</view>

.shop-card {
  background: linear-gradient(135deg, var(--color-primary-bg), rgba(99, 102, 241, 0.03));
  border: 1rpx solid rgba(79, 70, 229, 0.08);
}

.stats-row {
  gap: 12rpx;
}

.metric {
  flex: 1;
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-md);
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.5);
}

.metric-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
}

.member-card {
  cursor: pointer;
}

.member-card:active {
  opacity: 0.96;
  transform: scale(0.995);
}

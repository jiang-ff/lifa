page {
  background: #f6f7fb;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.35;
}

.container {
  padding: 24rpx;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
}

.card-soft {
  background: #f3f4f6;
  border-radius: 20rpx;
  padding: 24rpx;
}

button::after {
  border: 0;
}

.muted {
  color: #6b7280;
}

.divider {
  height: 1rpx;
  background: #eef0f4;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7280;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-12 {
  gap: 12rpx;
}

.btn {
  background: #111827;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-weight: 700;
}

.btn-secondary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-weight: 700;
}

.btn-ghost {
  background: #ffffff;
  border: 2rpx solid #111827;
  color: #111827;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-weight: 700;
}

.btn-danger {
  background: #ef4444;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-weight: 700;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f3f4f6;
  color: #111827;
}

.chip-outline {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  color: #111827;
}

.chip-green {
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
}

.chip-gray {
  background: #f3f4f6;
  color: #6b7280;
}

.chip-red {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

.field {
  padding: 18rpx 0;
}

.label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.input,
textarea,
.picker {
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.seg-item-active {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.08);
  font-weight: 700;
}
